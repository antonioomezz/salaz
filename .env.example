# Opcional: chave da YouTube Data API v3, para a busca do bot de música.
# Sem ela o bot ainda funciona, lendo a página de resultados do YouTube.
# A cota é um teto rígido e NÃO gera cobrança.
YOUTUBE_API_KEY=

# Opcional: só preencha se alguém não conseguir conectar na voz.
# O app funciona sem isso, usando apenas STUN público.

# Aceita várias URLs separadas por vírgula
NEXT_PUBLIC_TURN_URL=turn:seu-servidor:3478
NEXT_PUBLIC_TURN_USERNAME=usuario
NEXT_PUBLIC_TURN_CREDENTIAL=senha
